# Optional, first run only: Leaf copies this into your data repo's config.json, and every device reads it from there.
# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services → Credentials).
# Authorized JavaScript origins must include http://localhost:5180 (and your Pages URL if deployed).
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
